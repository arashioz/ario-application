# === آریو — دیپلوی روی IP سرور (بدون دامنه) ===
# کپی: cp .env.prod.example .env.prod

# IP عمومی سرور را بگذار (مثال)
DOMAIN=YOUR.SERVER.IP

# روی IP فقط selfsigned یا off مجاز است (Let's Encrypt دامنه می‌خواهد)
# selfsigned = HTTPS (برای GPS موبایل لازم است — مرورگر یک‌بار هشدار می‌دهد)
# off        = فقط HTTP (بدون هشدار؛ GPS روی موبایل کار نمی‌کند)
SSL_MODE=selfsigned

CERTBOT_EMAIL=admin@example.com

SHOP_OPENING_DATE=2025-05-27
PORT=3001
WS_PATH=/ws
NODE_ENV=production
