# ---- Build Ionic / Vite SPA ----
FROM node:22-alpine AS frontend-build
WORKDIR /app

# Cypress باینری چندصد مگابایت دانلود می‌کند و روی سرور «گیر» به نظر می‌رسد
ENV CYPRESS_INSTALL_BINARY=0 \
    npm_config_audit=false \
    npm_config_fund=false \
    npm_config_progress=true \
    npm_config_fetch_retries=5 \
    npm_config_fetch_retry_mintimeout=20000 \
    npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_fetch_timeout=300000

COPY mobile/.npmrc mobile/package.json mobile/package-lock.json ./

# optional deps لازم است (باینری native رول‌آپ روی Alpine/musl)
# معماری سرور ممکن است x64 یا arm64 باشد
RUN npm ci --legacy-peer-deps --no-audit --no-fund \
  && ARCH="$(uname -m)" \
  && case "$ARCH" in \
       x86_64|amd64) ROLLUP_PKG=@rollup/rollup-linux-x64-musl ;; \
       aarch64|arm64) ROLLUP_PKG=@rollup/rollup-linux-arm64-musl ;; \
       *) echo "unsupported arch: $ARCH" >&2; exit 1 ;; \
     esac \
  && echo "Installing $ROLLUP_PKG for $ARCH" \
  && npm install --no-save "$ROLLUP_PKG" \
  && npm cache clean --force

COPY mobile/ ./

# SIGKILL = OOM. درخواست ۳GB heap روی VPS کوچک بدتر می‌کند.
# VITE_LOW_MEM: بدون @vitejs/plugin-legacy و بدون workbox (نصف رم مصرفی)
ENV NODE_ENV=production \
    VITE_LOW_MEM=1 \
    NODE_OPTIONS=--max-old-space-size=1536

RUN npx vite build

# ---- Nginx (SPA + reverse proxy + SSL) ----
FROM nginx:1.27-alpine

RUN apk add --no-cache openssl bash curl gettext

COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/templates/ /etc/nginx/ario-templates/
COPY deploy/nginx/docker-entrypoint.d/ /docker-entrypoint.d/
COPY --from=frontend-build /app/dist /usr/share/nginx/html

RUN rm -rf /etc/nginx/templates/* \
  && mkdir -p /var/www/certbot /etc/letsencrypt /etc/nginx/ssl /etc/nginx/conf.d \
  && chmod +x /docker-entrypoint.d/*.sh

EXPOSE 80 443

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1/healthz || exit 1
