# کلید دسترسی Map.ir (اختیاری — پیش‌فرض خاموش چون اغلب منقضی است)
# فقط اگر کلید معتبر داری این را true کن:
# VITE_USE_MAPIR=true
# VITE_MAPIR_KEY=...
VITE_MAPIR_KEY=

# در حالت عادی روی HTTPS از پروکسی Vite استفاده می‌شود (wss → backend)
# فقط اگر بخواهی مستقیم به IP وصل شوی (بدون HTTPS):
# VITE_DIRECT_API=true
# VITE_API_HOST=192.168.100.107
