{
  "name": "ario-shop",
  "version": "1.0.0",
  "private": true,
  "description": "سیستم مدیریت مغازه - Ionic + React Native + WS + MongoDB",
  "scripts": {
    "backend": "cd backend && npm run dev",
    "seed": "cd backend && npm run seed",
    "backend:seed": "cd backend && npm run seed",
    "mobile": "cd mobile && npm start",
    "mobile:android": "cd mobile && npm run android",
    "ionic": "cd mobile && npm run dev",
    "ionic:build": "cd mobile && npm run build",
    "docker:up": "docker compose --env-file .env.prod up -d --build",
    "docker:down": "docker compose --env-file .env.prod down",
    "deploy:up": "bash deploy/up.sh",
    "deploy:ssl": "bash deploy/init-ssl.sh",
    "deploy:down": "docker compose --env-file .env.prod down",
    "deploy:logs": "docker compose --env-file .env.prod logs -f",
    "setup": "cp -n .env.prod.example .env.prod; npm run deploy:up"  }
}
